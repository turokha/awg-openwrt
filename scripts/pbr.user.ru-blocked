#!/bin/sh
# Efficiently attach a large domain list to the PBR AWG user nft set.
# This file is sourced by /etc/init.d/pbr.

TARGET_INTERFACE='awg0'
TARGET_NFTSET_4="pbr_${TARGET_INTERFACE}_4_dst_ip_user"
TARGET_TABLE='inet fw4'
DOMAIN_FILE='/etc/pbr/vpn-domains.txt'
DNSMASQ_FILE="${packageDnsmasqFile:-/var/run/pbr.dnsmasq}"
CHUNK_SIZE=200

[ -s "$DOMAIN_FILE" ] || return 1
touch "$DNSMASQ_FILE"

awk -v target="4#inet#fw4#$TARGET_NFTSET_4" -v chunk="$CHUNK_SIZE" '
function flush_line() {
    if (n > 0) {
        print "nftset=" domains "/" target
        domains=""
        n=0
    }
}
NF {
    if (n == 0) domains="/" $0
    else domains=domains "/" $0
    n++
    if (n >= chunk) flush_line()
}
END { flush_line() }
' "$DOMAIN_FILE" >> "$DNSMASQ_FILE" || return 1

return 0
